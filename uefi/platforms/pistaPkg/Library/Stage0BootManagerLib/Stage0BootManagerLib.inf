[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = PistaStage0BootManagerLib
  FILE_GUID = 870012AA-30F2-51AB-A459-1D5090097A4D
  MODULE_TYPE = DXE_DRIVER
  VERSION_STRING = 0.1
  LIBRARY_CLASS = DeviceBootManagerLib|DXE_DRIVER
# The Piano*.c sources and the shared core headers are copied from uefi/core
# into the workspace copy of this library by tools/dev/prepare_pista.py.
[Sources]
  Stage0BootManagerLib.c
  PistaDdrMemory.c
  NativeModules.h
  PistaDeviceTree.h
  PianoUsbController.c
  PianoDwc3Device.c
  PianoUsbControl.c
  PianoUsbPhy.c
  PianoFastboot.c
  PianoFastbootScreen.c
  PianoFastbootBlockRead.c
  PianoSmmu.c
  PianoDma.c
  PianoOwnedSmmu.c
  PianoIoPageTable.c
  PianoFaultRecovery.c
  PianoUfsProbe.c
  PianoUfsReadOnlyDma.c
  PianoUfsDmaLayout.c
  PianoGpt.c
  PianoBlockIo.c
[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MsCorePkg/MsCorePkg.dec
  QcomPkg/QcomPkg.dec
  SiliciumPkg/SiliciumPkg.dec
  CryptoPkg/CryptoPkg.dec
[LibraryClasses]
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DebugLib
  BaseLib
  BaseMemoryLib
  DevicePathLib
  MemoryAllocationLib
  TimerLib
  IoLib
  CacheMaintenanceLib
  DxeServicesTableLib
  DxeServicesLib
  FdtLib
  MemoryMapLib
  PrintLib
  SerialPortLib
  ArmSmcLib
  # The null implementation without secure boot: "oem sha256" reports unavailable.
  BaseCryptLib
[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiFirmwareVolume2ProtocolGuid
  gEfiCpuArchProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiPartitionInfoProtocolGuid
  gQcomScmProtocolGuid
[Guids]
  gEfiEventExitBootServicesGuid
[BuildOptions]
  # USB Fastboot over USB 2.0 with read-only UFS: "fetch" reads GPT partitions;
  # nothing writes to UFS. No USB host.
  # "oem ramlog" exports the whole UEFI_RamLog ring written by RamLogSerialPortLib.
  GCC:*_CLANGPDB_AARCH64_CC_FLAGS = -DPIANO_USB_SERVICE=1 -DPIANO_USB_EP0=1 -DPIANO_USB_FASTBOOT=1 -DPIANO_USB_SCREENSHOT=1 -DPIANO_USB_UFS_FETCH=1 -DPIANO_UFS_BLOCKIO=1 -DPIANO_USB_SUPERSPEED=0 -DSUNUEFI_DEVICE_NAME=\"pista\" -DPIANO_USB_CONSOLE_BASE=0xD7E00000U -DPIANO_USB_DIAG_LOG_BYTES=0x200000U
