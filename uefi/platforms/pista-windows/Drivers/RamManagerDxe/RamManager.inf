  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  DxeServicesTableLib
  FdtLib
  HobLib
  MemoryAllocationLib
  MemoryMapLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gFdtHobGuid

[Protocols]
  gEfiCpuArchProtocolGuid

[Depex]
  gEfiCpuArchProtocolGuid
