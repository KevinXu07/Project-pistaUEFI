# Realme GT7 Pro (pista) first RAM boot; merge after defconfig and
# piano-ram.config. Only the drivers that pista's minimal device tree uses are
# built in: display through the UEFI framebuffer, and a USB serial gadget.
# Storage stays off as in piano-ram.config; modules are not built or loaded.
CONFIG_LOCALVERSION="-pista"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEBUG_INFO_NONE=y

# Clocks, pins, power and interconnects the USB controller depends on.
CONFIG_PINCTRL_SM8750=y
CONFIG_SM_GCC_8750=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8750=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y

# The USB controller reaches memory through apps_smmu; UEFI hands it over
# with no context bank, so Linux has to own the SMMU before USB can do DMA.
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y

# USB 2.0 peripheral only: pista's USB3 PHY is disabled in the stock device
# tree. g_serial gives the computer a serial console (ttyGS0).
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y

# Readable framebuffer console on the 1264x2780 panel.
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
